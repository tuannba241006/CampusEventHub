{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:api": "jest tests/api --runInBand",
    "test:watch": "jest --watch",
    "reminder:run": "node scripts/run-reminder.js",
    "package5:demo": "node scripts/package5-demo-data.js",
    "package5:integration": "jest --runInBand tests/integration/package5.api.integration.test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^../config/supabase.js$": "<rootDir>/src/config/supabase.js",
      "^../src/utils/jwt.js$": "<rootDir>/src/utils/jwt.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  }
}